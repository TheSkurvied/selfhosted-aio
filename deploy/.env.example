# =============================================================================
# aio stack - environment for deploy/compose.yaml
# Copy to .env (chmod 600) and fill in. Never commit .env.
#
# Generate secrets with:   openssl rand -hex 32   (64 hex chars)
# Generate DB passwords:   openssl rand -hex 24   (hex keeps URIs URL-safe)
# Or run all of them at once:
#   for v in AIOSTREAMS_SECRET_KEY AIOMETADATA_ADMIN_KEY AIOMETADATA_IMAGE_PROXY_SIGNING_SECRET MANAGER_KEY; do echo "$v=$(openssl rand -hex 32)"; done
#   for v in POSTGRES_SUPERUSER_PASSWORD AIOSTREAMS_DB_PASSWORD AIOMETADATA_DB_PASSWORD MANAGER_DB_PASSWORD RESTIC_PASSWORD; do echo "$v=$(openssl rand -hex 24)"; done
# =============================================================================


# -----------------------------------------------------------------------------
# Domain / TLS (Caddy)
# -----------------------------------------------------------------------------
# Apex domain. Caddy serves streams.<DOMAIN>, meta.<DOMAIN>, manage.<DOMAIN>.
# Create A (and AAAA) records for all three before the first start.
DOMAIN=example.com
# Contact address for Let's Encrypt expiry/problem mails.
ACME_EMAIL=admin@example.com
# Space-separated CIDRs allowed to open the addon dashboards (/dashboard and
# their admin APIs). Default: everyone (apps' own logins still apply).
# Example: ADMIN_ALLOW_CIDRS="203.0.113.7/32 100.64.0.0/10"
ADMIN_ALLOW_CIDRS="0.0.0.0/0 ::/0"
# Container timezone (AIOMetadata quiet hours etc.).
TZ=Europe/Berlin


# -----------------------------------------------------------------------------
# Image tags (pinned majors; bump deliberately after reading changelogs)
# -----------------------------------------------------------------------------
# AIOStreams publishes vX.Y.Z, vX.Y, vX and latest.
AIOSTREAMS_TAG=v2
# AIOMetadata publishes X.Y.Z, X.Y, X and latest. Do NOT use v5.0.0 (stray tag).
AIOMETADATA_TAG=3
AIO_MANAGER_IMAGE=ghcr.io/theskurvied/aio-manager:latest


# -----------------------------------------------------------------------------
# PostgreSQL 17 (one cluster, three databases)
# Roles are created ONCE on first start by postgres-init/. Changing these later
# needs an ALTER ROLE (see postgres-init/10-create-databases.sh).
# -----------------------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=
AIOSTREAMS_DB_PASSWORD=
AIOMETADATA_DB_PASSWORD=
MANAGER_DB_PASSWORD=


# -----------------------------------------------------------------------------
# AIOStreams (streams.<DOMAIN>)
# BASE_URL and DATABASE_URI are built in compose.yaml from DOMAIN and the
# password above.
# -----------------------------------------------------------------------------
# !!! NEVER CHANGE AFTER FIRST START !!!
# Passed to AIOStreams as SECRET_KEY. Encrypts every stored user config.
# Changing or losing it makes ALL existing configs undecryptable. Back it up
# in your password manager, separately from the server.
# 64 hex chars: openssl rand -hex 32
AIOSTREAMS_SECRET_KEY=
# Operator logins for the dashboard: "user:password[,user2:password2]".
# Users not listed in AIOSTREAMS_AUTH_PERMISSIONS default to admin.
# Example: AIOSTREAMS_AUTH=admin:<openssl rand -hex 16>
AIOSTREAMS_AUTH=
# error | warn | info | http | verbose | debug | silly
AIOSTREAMS_LOG_LEVEL=info
#
# Runtime settings: set these in the AIOStreams dashboard (Settings) instead.
# If you really want them pinned in env, uncomment the matching line in
# compose.yaml (an env value locks the field in the UI):
#   AIOSTREAMS_AUTH_PERMISSIONS=alice=admin,bob=proxy   (admin|proxy|service|sabnzbd|none)
#   AIOSTREAMS_TRUSTED_UUIDS=         -> TRUSTED_UUIDS
#   ADDON_PROXY=http://gluetun:8888   -> outbound proxy, used with
#   ADDON_PROXY_CONFIG=*:false,*.strem.fun:true
#   DEFAULT_TIMEOUT=5000              (per-addon timeout, ms; default 7000)


# -----------------------------------------------------------------------------
# AIOMetadata (meta.<DOMAIN>)
# HOST_NAME, DATABASE_URI and REDIS_URL are built in compose.yaml.
# -----------------------------------------------------------------------------
# Admin key for /dashboard and the admin API (x-admin-key header). Also used by
# aio-manager. openssl rand -hex 32
AIOMETADATA_ADMIN_KEY=
# HMAC secret for signed /poster, /logo, /background URLs. Rotating it breaks
# image URLs already cached by clients (they re-fetch). openssl rand -hex 32
AIOMETADATA_IMAGE_PROXY_SIGNING_SECRET=
# Instance password required to create configs. Leave empty for an open
# instance. Recommended for a private instance.
AIOMETADATA_ADDON_PASSWORD=
AIOMETADATA_LOG_LEVEL=info
# Redis maxmemory for the dedicated AIOMetadata Redis (CX23 has 4 GB RAM).
AIOMETADATA_REDIS_MAXMEMORY=768mb
# essential | comprehensive. Warming spends upstream API quota.
CACHE_WARMUP_MODE=essential
#
# Server-side API keys (BUILT_IN_*). They never leave the server. Every user of
# the instance spends them. Do NOT use the plain TMDB_API_KEY-style names: those
# are served to every visitor by /api/config.
BUILT_IN_TMDB_API_KEY=
BUILT_IN_TVDB_API_KEY=
BUILT_IN_FANART_API_KEY=
BUILT_IN_RPDB_API_KEY=
# Paid per call (MDBList past 1000 calls/day, Gemini per query):
# private instance only; leave empty on a shared one.
BUILT_IN_MDBLIST_API_KEY=
BUILT_IN_GEMINI_API_KEY=
#
# Anime: the public Jikan API shuts down on 2026-10-01. Self-host Jikan
# (see aiometadata docs/self-hosted-jikan.md) and point this at it, e.g.
# http://jikan_rest:8080/v4 once it joins the edge network.
JIKAN_API_BASE=https://api.jikan.moe/v4
#
# Optional Trakt integration. Redirect URI is fixed in compose.yaml to
# https://meta.<DOMAIN>/api/auth/trakt/callback - register that at trakt.tv.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
DISABLE_TRAKT_SEARCH=false


# -----------------------------------------------------------------------------
# aio-manager (manage.<DOMAIN>)
# DATABASE_URL is built in compose.yaml from MANAGER_DB_PASSWORD.
# -----------------------------------------------------------------------------
# AES-256-GCM key that encrypts every upstream password and debrid key the
# manager stores. 64 hex chars: openssl rand -hex 32
# Losing it makes the manager DB useless. To rotate it, use the manager's own
# tool: docker compose exec -e OLD_MANAGER_KEY=<old> aio-manager node build/cli/rotate-key.mjs
# (after putting the new key here and recreating the container). Lost admin
# access: docker compose exec aio-manager node build/cli/reset-admin.mjs <email> --password --totp
MANAGER_KEY=
# AIOStreams login used by the manager. Only needed when
# AIOSTREAMS_AUTH_REQUIRED=true. The user must be listed in AIOSTREAMS_AUTH
# and in AIOSTREAMS_AUTH_PERMISSIONS (unlisted users default to admin).
MANAGER_AIOSTREAMS_USERNAME=
MANAGER_AIOSTREAMS_PASSWORD=
# Optional OIDC sign-in for the manager (Authentik, Pocket ID, Google, ...).
# All four must be set to enable it; otherwise local password + TOTP is used.
MANAGER_OIDC_ISSUER=
MANAGER_OIDC_CLIENT_ID=
MANAGER_OIDC_CLIENT_SECRET=
MANAGER_ADMIN_EMAILS=
# Optional ntfy topic URL for drift/missing alerts, e.g. https://ntfy.sh/xyz
MANAGER_NTFY_URL=
# Hours between automatic drift checks (0 disables).
MANAGER_CHECK_INTERVAL_HOURS=6


# -----------------------------------------------------------------------------
# Backups (scripts/backup.sh, run by cron on the host)
# -----------------------------------------------------------------------------
# restic repository. Hetzner Storage Box over SFTP (port 23, set up in
# ~/.ssh/config as Host "storagebox", see docs/02-hosting.md):
RESTIC_REPOSITORY=sftp:storagebox:restic-aio
# ...or any S3-compatible bucket:
# RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/aio
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Encrypts the backup repository. Lose it and the backups are unreadable.
# Store it in your password manager. openssl rand -hex 24
RESTIC_PASSWORD=
# Local staging directory for dumps/tarballs (kept for the last run only).
BACKUP_STAGING_DIR=/var/backups/aio
# restic retention.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6


# -----------------------------------------------------------------------------
# Optional gluetun (commented service in compose.yaml)
# -----------------------------------------------------------------------------
# GLUETUN_VPN_SERVICE_PROVIDER=mullvad
# GLUETUN_WIREGUARD_PRIVATE_KEY=
# GLUETUN_SERVER_COUNTRIES=Netherlands
