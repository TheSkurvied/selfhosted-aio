# Local development. Production values come from ../deploy/.env via compose.
DATABASE_URL=postgres://manager:manager@localhost:5432/aio_manager
TEST_DATABASE_URL=postgres://manager:manager@localhost:5432/aio_manager_test
# openssl rand -hex 32
MANAGER_KEY=
PUBLIC_URL=http://localhost:5173
# pnpm dev:mocks serves both mocks on these ports.
AIOSTREAMS_INTERNAL_URL=http://localhost:13000
AIOSTREAMS_PUBLIC_URL=http://localhost:13000
AIOMETADATA_INTERNAL_URL=http://localhost:13232
AIOMETADATA_PUBLIC_URL=http://localhost:13232
AIOMETADATA_ADMIN_KEY=dev-admin-key
AIOMETADATA_ADDON_PASSWORD=dev-addon-password
# Optional: AIOSTREAMS_USERNAME, AIOSTREAMS_PASSWORD, OIDC_ISSUER, OIDC_CLIENT_ID,
# OIDC_CLIENT_SECRET, ADMIN_EMAILS, NTFY_URL, CHECK_INTERVAL_HOURS, AIOSTREAMS_USER_API_LIMIT
